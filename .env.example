# Core site build
GITHUB_USERNAME=your-github-username
# Optional, but recommended to avoid low GitHub API rate limits
GITHUB_TOKEN=your-github-token

# CMS auth
SESSION_SECRET=replace-with-a-long-random-secret
CMS_PASSWORD_HASH=replace-with-bcrypt-hash

# Deployment adapter for CMS publish/delete
# Options: none | command | webhook
DEPLOY_MODE=none

# Toggle automatic deploy after post actions
AUTO_DEPLOY_ON_PUBLISH=false
AUTO_DEPLOY_ON_DELETE=false

# Required when DEPLOY_MODE=command
# Example: DEPLOY_COMMAND="netlify deploy --prod --dir=dist"
DEPLOY_COMMAND=

# Required when DEPLOY_MODE=webhook
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_METHOD=POST
# Optional shared secret sent as x-deploy-secret header
DEPLOY_WEBHOOK_SECRET=

# Weekly backup schedule for cron installer (default: Sundays at 03:00)
# Format: minute hour day-of-month month day-of-week
WEEKLY_BACKUP_CRON="0 3 * * 0"

# Weekly backup schedule for systemd timer with catch-up support
# Example: Sun *-*-* 03:00:00
SYSTEMD_WEEKLY_BACKUP_ONCALENDAR="Sun *-*-* 03:00:00"
