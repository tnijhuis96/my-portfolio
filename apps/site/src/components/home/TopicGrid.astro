---
interface Topic {
  title: string;
  slug: string;
  description: string;
}

const { topics } = Astro.props as { topics: Topic[] };
---
<section class="container">
  <h2>Topics</h2>
  <div class="topic-grid">
    {topics.map((topic) => (
      <a href={`/topics/${topic.slug}/`} class="topic-card">
        <h3>{topic.title}</h3>
        <p>{topic.description}</p>
      </a>
    ))}
  </div>
</section>
