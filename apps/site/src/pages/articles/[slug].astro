---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blocksToParagraphs, type PortableTextBlock } from "../../lib/content/portableText";
import type { SanityArticleRecord } from "../../lib/content/sanity";
import { hasSanityConfig, sanityClient } from "../../lib/sanity/client";
import { articleDetailQuery, articleSlugListQuery } from "../../lib/sanity/queries";

type ArticleDetail = SanityArticleRecord & {
  body?: PortableTextBlock[];
};

export async function getStaticPaths() {
  if (!hasSanityConfig) {
    return [];
  }

  const slugs = await sanityClient.fetch<Array<{ slug: string }>>(articleSlugListQuery);

  return slugs.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug = "" } = Astro.params;
const article =
  hasSanityConfig && slug
    ? await sanityClient.fetch<ArticleDetail | null>(articleDetailQuery, { slug })
    : null;

const paragraphs = blocksToParagraphs(article?.body);
---
<BaseLayout title={article?.title ?? "Article"} description={article?.summary}>
  <article class="container">
    <h1>{article?.title ?? "Article unavailable"}</h1>
    {article?.summary && <p>{article.summary}</p>}
    {(article?.topics?.length ?? 0) > 0 && (
      <p>
        Topics:
        {" "}
        {article?.topics?.map((topic) => (
          <a href={`/topics/${topic.slug.current}/`}>{topic.title}</a>
        ))}
      </p>
    )}
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </article>
</BaseLayout>
