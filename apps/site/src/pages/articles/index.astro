---
import ArticleList from "../../components/articles/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mapArticle } from "../../lib/content/mapArticle";
import type { SanityArticleRecord } from "../../lib/content/sanity";
import { hasSanityConfig, sanityClient } from "../../lib/sanity/client";
import { articleListQuery } from "../../lib/sanity/queries";

const rawArticles = hasSanityConfig
  ? await sanityClient.fetch<SanityArticleRecord[]>(articleListQuery)
  : [];

const articles = rawArticles.map(mapArticle);
---
<BaseLayout title="Articles">
  <section class="container">
    <h1>Articles</h1>
    <ArticleList articles={articles} />
  </section>
</BaseLayout>
