---
import BaseLayout from "../layouts/BaseLayout.astro";
import { blocksToParagraphs, type PortableTextBlock } from "../lib/content/portableText";
import { hasSanityConfig, sanityClient } from "../lib/sanity/client";
import { nowPageQuery } from "../lib/sanity/queries";

type NowPage = {
  title?: string;
  body?: PortableTextBlock[];
};

const nowPage = hasSanityConfig ? await sanityClient.fetch<NowPage | null>(nowPageQuery) : null;
const paragraphs = blocksToParagraphs(nowPage?.body);
---
<BaseLayout title="Now">
  <section class="container">
    <h1>{nowPage?.title ?? "Now"}</h1>
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>
</BaseLayout>
