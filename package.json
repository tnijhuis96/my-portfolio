{
  "name": "my-portfolio",
  "version": "1.0.0",
  "main": "build.js",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "gray-matter": "^4.0.3",
    "marked": "^4.3.0",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build.js && npx pagefind --site dist",
    "admin": "node adminServer.js",
    "preview": "wrangler dev",
    "preview:dist": "npx serve dist -l 4173",
    "cms:hash-password": "node scripts/hash-cms-password.js",
    "cms:migrate": "wrangler d1 migrations apply CMS_DB --local",
    "cms:test": "node --test tests/cms-module-scope.test.cjs tests/cms-auth.test.js tests/cms-content.test.js tests/cms-route-guards.test.js tests/cms-admin-ui.test.cjs tests/cms-tooling.test.cjs",
    "cms:verify": "npm run cms:test && wrangler d1 migrations apply CMS_DB --local && npm run build",
    "dev:new-site": "npm run dev --workspace apps/site",
    "dev:studio": "npm run dev --workspace apps/studio",
    "build:new-site": "npm run build --workspace apps/site",
    "check:new-site": "npm run check --workspace apps/site && npm run test --workspace apps/site",
    "backup:posts": "node scripts/backup-posts.js",
    "backup:weekly:install": "node scripts/weekly-backup-cron.js install",
    "backup:weekly:remove": "node scripts/weekly-backup-cron.js remove",
    "backup:weekly:status": "node scripts/weekly-backup-cron.js status",
    "backup:weekly:systemd:install": "node scripts/weekly-backup-systemd.js install",
    "backup:weekly:systemd:remove": "node scripts/weekly-backup-systemd.js remove",
    "backup:weekly:systemd:status": "node scripts/weekly-backup-systemd.js status",
    "deploy": "wrangler deploy",
    "deploy:gh-pages": "npm run build && gh-pages -d dist",
    "build:studio": "npm run build --workspace apps/studio"
  },
  "keywords": [],
  "author": "Thomas Nijhuis",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "pagefind": "^1.4.0",
    "wrangler": "^4.71.0"
  },
  "private": true,
  "workspaces": [
    "apps/site",
    "apps/studio"
  ]
}
